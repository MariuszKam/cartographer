<component name="InspectionProjectProfileManager">
  <profile version="1.0">
    <option name="myName" value="Project Default" />
    <!-- The repository contains JavaFX CSS only. IntelliJ's web-CSS inspections
         do not model JavaFX -fx-* properties, programmatic style classes, or
         JavaFX pseudo-classes, so these checks are not valid for this project. -->
    <inspection_tool class="CssInvalidPseudoSelector" enabled="false" level="WARNING" enabled_by_default="false" />
    <inspection_tool class="CssUnknownProperty" enabled="false" level="WARNING" enabled_by_default="false" />
    <inspection_tool class="CssUnusedSymbol" enabled="false" level="WARNING" enabled_by_default="false" />

    <!-- These Java inspections encode stylistic preferences that conflict with
         deliberate project contracts: Optional models absence explicitly,
         positive predicates retain domain meaning, and constant-return helpers
         encapsulate stable singleton/script behavior. -->
    <inspection_tool class="BooleanMethodIsAlwaysInverted" enabled="false" level="WARNING" enabled_by_default="false" />
    <inspection_tool class="OptionalUsedAsFieldOrParameterType" enabled="false" level="WARNING" enabled_by_default="false" />
    <inspection_tool class="SameReturnValue" enabled="false" level="WARNING" enabled_by_default="false" />

    <!-- Extract-method recommendations are refactoring suggestions, not defect
         diagnostics. Keeping them out of the warning budget prevents code from
         being fragmented merely to satisfy an IDE heuristic. -->
    <inspection_tool class="ExtractMethodRecommender" enabled="false" level="WEAK WARNING" enabled_by_default="false" />

    <!-- Duplicate-code detection is a refactoring heuristic. Similar control
         flow can belong to intentionally separate architectural responsibilities,
         so it is reviewed deliberately instead of enforced as a zero-warning gate. -->
    <inspection_tool class="DuplicatedCode" enabled="false" level="WEAK WARNING" enabled_by_default="false" />
  </profile>
</component>
